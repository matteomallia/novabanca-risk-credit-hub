cat > .gitignore << 'EOF'
# --- Segreti e variabili d'ambiente ---
.env
.env.local
.env.*.local

# --- Dipendenze ---
node_modules/
backend/node_modules/
frontend/node_modules/
__pycache__/
*.pyc
.venv/
venv/

# --- Build & output generati ---
frontend/dist/
data_agent/static/charts/*.png
chroma_data/

# --- File di sistema ---
.DS_Store
Thumbs.db

# --- IDE ---
.vscode/
.idea/

# --- Log ---
*.log
npm-debug.log*
EOF