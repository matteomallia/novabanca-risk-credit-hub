# =============================================================================
# INTESA SANPAOLO RISK & CREDIT INTELLIGENCE HUB - ENVIRONMENT VARIABLES
# =============================================================================
# Copia questo file in ".env" e sostituisci i placeholder con le tue credenziali.
# NON committare mai il file ".env" reale nel version control.

# --- OPENAI LLM CONFIGURATION ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- MICROSERVICES INTERNAL ENDPOINTS (DOCKER NETWORK) ---
PORT=5000
NODE_ENV=development
DATA_AGENT_URL=http://data_agent:8000
CHROMADB_URL=http://chromadb:8000

# --- SMTP MAIL SERVICE (NODEMAILER EXECUTIVE REPORTS) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM=your_from_address_here

# --- FINANCIAL MARKET DATA API (FTSE MIB & NEWS TICKER) ---
MARKETAUX_API_KEY=your_marketaux_api_key_here
